# StockHub — one file for `web/` + `api/`. Copy to `.env` at this repo root.
# Do not commit `.env`.

# Database (API + Prisma; never bundled to the browser by Next)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Same value in this file only — used by Express (sign) and Next (verify)
AUTH_SECRET=replace-with-random-string-at-least-32-chars

# Backend
FRONTEND_URL=http://localhost:3000
PORT=4000

# Next.js rewrites: /api/* → Express
API_URL=http://localhost:4000

# Pending signup verification link lifetime in minutes (default 1440 = 24h if unset).
# Use a small value locally for quick expiry tests, e.g. VERIFY_TTL_MINUTES=2
# VERIFY_TTL_MINUTES=1440

# API hardening (optional)
# TRUST_PROXY=1              # behind reverse proxy — restores client IP for rate limits (use 2+ if multiple hops)
# API_JSON_BODY_LIMIT=256kb # max JSON body size for Express (default 256kb if unset)
# RATE_LIMIT_DISABLED=1      # disable auth route limits (local stress tests only)

# Email (signup): set MAIL_PROVIDER=brevo or resend; match BREVO_API_KEY / RESEND_API_KEY + EMAIL_FROM (verified sender).
# Brevo: https://app.brevo.com → SMTP & API → API keys & SMTP → generate v3 key
# MAIL_PROVIDER=brevo   # use resend / stray RESEND_API_KEY in OS env won't hijack sends
# BREVO_API_KEY=xkeysib-...
# EMAIL_FROM=StockHub <noreply@your-verified-sender.com>

# Optional: Resend instead (if BREVO_API_KEY is unset)
# RESEND_API_KEY=re_...

# Optional: superadmin seed (`cd api && npm run db:seed`)
# SEED_SUPERADMIN_EMAIL=admin@example.com
# SEED_SUPERADMIN_PASSWORD=
# SEED_SUPERADMIN_FIRST_NAME=Super
# SEED_SUPERADMIN_LAST_NAME=Admin
# (optional legacy single field, split on first space)
# SEED_SUPERADMIN_NAME=Super Admin
