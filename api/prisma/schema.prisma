// StockHub — PostgreSQL (Supabase) + Auth.js adapter + domain models
// Business rule: at most one User with SUPERADMIN — enforce in app/DB (partial unique index optional).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Auth.js (Prisma adapter) + app fields ---------------------------------

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

/// A row exists only after the email is verified (password flow: PendingRegistration → verify-email).
model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  emailVerified DateTime
  image         String?
  password      String?   @db.Text // bcrypt/argon hash; null for OAuth-only users
  role          UserRole  @default(USER)
  lastSeenAt    DateTime?

  accounts             Account[]
  sessions             Session[]
  movements            Movement[]
  notifications        Notification[]
  supplierOrdersClosed SupplierOrder[] @relation("SupplierOrderClosedBy")
  supplierOrdersCreated SupplierOrder[] @relation("SupplierOrderCreatedBy")
  customerOrders       CustomerOrder[]
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Signup draft: not a user until verify-email creates `User`.
model PendingRegistration {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @db.Text
  firstName    String
  lastName     String
  token        String   @unique
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Catalog & stock --------------------------------------------------------

model Brand {
  id   String @id @default(cuid())
  name String @unique

  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  articles             Article[]
  attributeDefinitions AttributeDefinition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Fixed catalog row (warehouse SKU). Custom traits live in AttributeValue (EAV).
model Article {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  description  String? @db.Text
  stock        Int     @default(0)
  /// Minimum stock level before low-stock alerts.
  minThreshold Int     @default(0)

  isActive    Boolean  @default(true)
  barcode     String?  @unique
  price       Decimal? @db.Decimal(10, 2)
  weightGrams Int?
  imageUrl    String?

  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  attributeValues    AttributeValue[]
  movements          Movement[]
  supplierOrderLines SupplierOrderLine[]
  customerOrderLines CustomerOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
}

enum ArticleAttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  DATE
}

/// User-configurable attribute schema. When categoryId is null, applies to all categories.
model AttributeDefinition {
  id         String               @id @default(cuid())
  key        String               @unique
  label      String
  type       ArticleAttributeType
  isRequired Boolean              @default(false)
  sortOrder  Int                  @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  options AttributeOption[]
  values  AttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, sortOrder])
}

/// Allowed values for SELECT-type attribute definitions.
model AttributeOption {
  id           String @id @default(cuid())
  definitionId String
  value        String
  label        String?
  sortOrder    Int    @default(0)

  definition AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  values     AttributeValue[]

  @@unique([definitionId, value])
  @@index([definitionId, sortOrder])
}

/// One value per (article, definition). Typed columns match AttributeDefinition.type.
model AttributeValue {
  id           String @id @default(cuid())
  articleId    String
  definitionId String

  valueText    String?  @db.Text
  valueNumber  Decimal? @db.Decimal(12, 4)
  valueBoolean Boolean?
  optionId     String?

  article    Article             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  definition AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  option     AttributeOption?    @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([articleId, definitionId])
  @@index([definitionId])
  @@index([optionId])
}

enum MovementType {
  ADJUSTMENT // manual +/− rettifica
  LOAD       // e.g. automatic inbound after supplier order SUCCEEDED
  UNLOAD     // e.g. customer order creation
}

model Movement {
  id                       String        @id @default(cuid())
  type                     MovementType
  delta                    Int // positive or negative quantity change
  articleId                String
  userId                   String
  relatedSupplierOrderId   String?
  relatedCustomerOrderId   String?

  article              Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedSupplierOrder SupplierOrder? @relation(fields: [relatedSupplierOrderId], references: [id], onDelete: SetNull)
  relatedCustomerOrder CustomerOrder? @relation(fields: [relatedCustomerOrderId], references: [id], onDelete: SetNull)

  note      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
  @@index([userId, createdAt])
}

// --- Notifications ----------------------------------------------------------

model Notification {
  id       String    @id @default(cuid())
  userId   String
  type     String // e.g. STOCK_ADJUSTMENT, SUPPLIER_ORDER_ARRIVED
  title    String?
  body     String    @db.Text
  readAt   DateTime?
  // optional pointers for deep links / audit
  articleId        String?
  supplierOrderId  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// --- Staff chat (1:1 direct messages) --------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// --- Suppliers & purchase orders -------------------------------------------

model Supplier {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  address String? @db.Text

  orders SupplierOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SupplierOrderStatus {
  PENDING
  ARRIVED_CHECKING
  CHECKED
  SUCCEEDED
  DONE
}

model SupplierOrder {
  id     String              @id @default(cuid())
  code   String              @unique
  status SupplierOrderStatus @default(PENDING)

  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User     @relation("SupplierOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  checkedAt      DateTime? // when status became CHECKED
  closedAt       DateTime? // when SUCCEEDED or DONE
  closedById     String?
  closedBy       User?     @relation("SupplierOrderClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  adminCloseNote String?   @db.Text // free text at close (esp. DONE)

  lines    SupplierOrderLine[]
  movements Movement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([supplierId, createdAt(sort: Desc)])
}

model SupplierOrderLine {
  id                String @id @default(cuid())
  supplierOrderId   String
  articleId         String
  qtyOrdered        Int
  qtyReceivedActual Int? // filled during ARRIVED_CHECKING / CHECKED
  lineConform       Boolean? // "V" / conformity per riga; refine in UI

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  article       Article       @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@unique([supplierOrderId, articleId])
}

// --- Customers + customer orders --------------------------------------------

model Customer {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  address String? @db.Text

  orders CustomerOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CustomerOrderStatus {
  OPEN
  PICKED_UP
}

model CustomerOrder {
  id           String               @id @default(cuid())
  code         String               @unique
  status       CustomerOrderStatus  @default(OPEN)
  customerId   String
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdById  String
  createdBy    User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)

  lines CustomerOrderLine[]
  movements Movement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
}

model CustomerOrderLine {
  id              String @id @default(cuid())
  customerOrderId String
  articleId       String
  quantity        Int

  customerOrder CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  article       Article       @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@unique([customerOrderId, articleId])
}
